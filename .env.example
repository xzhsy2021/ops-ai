# Prefer copying one of these templates:
#   cp .env.local.example .env      # local development
#   cp .env.docker.example .env     # docker/local server deployment

ENV=local
# SECURITY: never commit a real value, and never reuse a value that appears in this
# template — it is public. Leaving it empty makes the app generate a random session
# secret per start (non-production) and refuse to start in production.
# Generate a unique value: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# Encrypts stored server credentials (SSH password/key, DB connection secrets).
# Empty = credentials are stored in plaintext (local development compatibility only).
# Generate a unique value: python -c "import secrets; print(secrets.token_urlsafe(48))"
OPS_SECRET_KEY=
# REQUIRED for approval workflows; startup fails while this is empty or weak.
# Generate a unique value: python -c "import secrets; print(secrets.token_urlsafe(48))"
APPROVAL_SIGNING_KEY=
# Legacy compatibility alias (use only when APPROVAL_SIGNING_KEY is absent): QCLAW_APPROVAL_SIGNING_KEY
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
APP_DATA_DIR=./data
OPS_DB_PATH=./data/ops.db
SFTP_ALLOWED_ROOTS=/data,/opt,/var/log,/tmp
TERMINAL_ALLOW_DANGEROUS=0

# Iter19 lightweight runtime defaults
SERVE_FRONTEND=auto
MAX_TERMINAL_SESSIONS=3
MAX_TERMINAL_SESSIONS_PER_USER_SERVER=2
TERMINAL_IDLE_TIMEOUT_SECONDS=600
TERMINAL_MAX_LIFETIME_SECONDS=3600
MAX_CONCURRENT_DEPLOYS=1
MAX_LOG_TAIL_LINES=500
TASK_IDLE_POLL_SECONDS=15
TASK_ACTIVE_POLL_SECONDS=2

# Windows users: see .env.windows.example and scripts/start_single_process.ps1.
# Performance / lightweight runtime
SLOW_REQUEST_MS=500
RESOURCE_CACHE_TTL_SECONDS=8
VITE_DEPLOY_POLL_ACTIVE_MS=2000
VITE_DEPLOY_POLL_HIDDEN_MS=15000

# ── 安全监控一键安装（ops.security_module.setup / 服务器页「安装」按钮）──
# 远程安装 deanchou/server_security_monitor 时注入的 Telegram 告警凭据。
# 复制 .env.example 为 .env 后在此填写真实值（.env 已被 .gitignore 排除，不会入库）；
# 留空则安装时跳过 Telegram 告警参数（fail2ban/auditd/每日日报/资源监控仍会安装）。
# 兼容别名：TG_BOT_TOKEN / TG_CHAT_ID（无前缀键名）。
SECURITY_MONITOR_TG_BOT_TOKEN=
SECURITY_MONITOR_TG_CHAT_ID=

# ── Matrix 部署包对接（可选）──
# 专用 Bot / Service 账号：拉房间事件、下载媒体（mxc://）到文件中心后触发发布。
# 未配置时 Matrix 发布 API 返回 503；加密房间需同时配置下方 E2EE 段。
# MATRIX_HOMESERVER_URL=https://matrix.example.org
# MATRIX_ACCESS_TOKEN=
# MATRIX_MEDIA_WINDOW_MINUTES=15
# MATRIX_HTTP_TIMEOUT=30
# MATRIX_MEDIA_MSGTYPES=m.file,m.image,m.video,m.audio

# ── Matrix E2EE（加密房间部署包解密，接入 matrix-nio[e2e] SDK）──
# 首次启用时 Bot 会生成新设备密钥并写入持久化 crypto store（Olm 账号 +
# Megolm 入站会话）。注意：
# - MATRIX_DEVICE_ID 必须保持稳定，更换会生成全新设备、丢失历史 room key；
# - crypto store 目录请纳入备份；清空后无法解密历史消息；
# - MATRIX_USER_ID 留空时通过 /account/whoami 自动解析。
# MATRIX_E2EE_ENABLED=true
# MATRIX_USER_ID=@ops-bot:example.org
# MATRIX_DEVICE_ID=OPS-AI-BOT
# MATRIX_CRYPTO_STORE_PATH=./data/matrix/crypto_store
# MATRIX_E2EE_SYNC_TIMEOUT_MS=8000
# Matrix 附件拉取是否放行任意文件格式（.txt/.pdf/.log 等普通文件）。
# 默认开启；设为 0 恢复部署包扩展名白名单。
# MATRIX_PULL_ALLOW_ANY_EXTENSION=1
