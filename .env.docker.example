ENV=production
# SECURITY: ENV=production 时留空或使用占位值会直接拒绝启动（fail-closed）。
# 本模板是公开文件，切勿写入真实值，也不要复用模板中的任何值。
# Generate a unique value: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# 用于加密库内服务器凭据；ENV=production 时必须配置为独立随机值。
# Generate a unique value: python -c "import secrets; print(secrets.token_urlsafe(48))"
OPS_SECRET_KEY=
# REQUIRED for approval workflows; startup fails while this is empty or weak.
# Generate a unique value: python -c "import secrets; print(secrets.token_urlsafe(48))"
APPROVAL_SIGNING_KEY=
# Legacy compatibility alias (use only when APPROVAL_SIGNING_KEY is absent): QCLAW_APPROVAL_SIGNING_KEY
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
APP_DATA_DIR=/data
DATABASE_URL=sqlite:////data/ops.db
SFTP_ALLOWED_ROOTS=/data,/opt,/var/log,/tmp
TERMINAL_ALLOW_DANGEROUS=0

# Iter19 lightweight runtime defaults
SERVE_FRONTEND=true
MAX_TERMINAL_SESSIONS=3
MAX_TERMINAL_SESSIONS_PER_USER_SERVER=2
TERMINAL_IDLE_TIMEOUT_SECONDS=600
TERMINAL_MAX_LIFETIME_SECONDS=3600
MAX_CONCURRENT_DEPLOYS=1
MAX_LOG_TAIL_LINES=500
TASK_IDLE_POLL_SECONDS=15
TASK_ACTIVE_POLL_SECONDS=2
# Performance / lightweight runtime
SLOW_REQUEST_MS=500
RESOURCE_CACHE_TTL_SECONDS=8
VITE_DEPLOY_POLL_ACTIVE_MS=2000
VITE_DEPLOY_POLL_HIDDEN_MS=15000

# ── Matrix 部署包对接（可选）──
# MATRIX_HOMESERVER_URL=https://matrix.example.org
# MATRIX_ACCESS_TOKEN=
# MATRIX_MEDIA_WINDOW_MINUTES=15
# MATRIX_HTTP_TIMEOUT=30
# MATRIX_MEDIA_MSGTYPES=m.file,m.image,m.video,m.audio

# ── Matrix E2EE（加密房间部署包解密，接入 matrix-nio[e2e] SDK）──
# DEVICE_ID 必须稳定；容器部署时把 crypto store 目录挂载到持久卷。
# MATRIX_E2EE_ENABLED=true
# MATRIX_USER_ID=@ops-bot:example.org
# MATRIX_DEVICE_ID=OPS-AI-BOT
# MATRIX_CRYPTO_STORE_PATH=/app/data/matrix/crypto_store
# MATRIX_E2EE_SYNC_TIMEOUT_MS=8000
