{
  "name": "ops-frontend",
  "private": true,
  "version": "2.1.13",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node ./scripts/generate-build-info.cjs",
    "build": "node ./node_modules/vite/bin/vite.js build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:approvers": "node --test ./tests/approverIdentities.test.js",
    "test:datetime": "node --test ./tests/datetime.test.js",
    "test:dashboard": "node --test ./tests/dashboardStatus.test.js",
    "test:guard": "node --test ./tests/requestGuard.test.js",
    "test:threshold": "node --test ./tests/inspectionThreshold.test.js",
    "test:unit": "node --test ./tests/approverIdentities.test.js ./tests/datetime.test.js ./tests/dashboardStatus.test.js ./tests/requestGuard.test.js ./tests/inspectionThreshold.test.js"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "axios": "^1.6.7",
    "lucide-react": "^0.468.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.3",
    "vite": "^5.1.0"
  }
}
